{
  "name": "Super Metroid Room Tracker",
  "description": "Displays the name of the current room. In addition, it emits an event for other addons to use.",
  "url": "https://cartbridge.net/addons/sm-room-tracker",
  "game": {
    "name": "Super Metroid",
    "platform": "snes",
    "crc32": "D63ED5F8",
    "md5": "21F3E98DF4780EE1C667B84E57D88675",
    "sha1": "DA957F0D63D14CB441D215462904C4FA8519C613"
  },
  "capabilities": {
    "wram:read": [
      {
        "address": "7E079B",
        "size": 2,
        "type": "hex",
        "event": "location:area:id",
        "description": "Current area identifier"
      }
    ],
    "events:emit": [
      {
        "name": "location:area",
        "description": "Emitted when a room lookup resolves the area name",
        "lookup": {
          "source": "location:area:id",
          "table": "rooms"
        },
        "parameters": {
          "name": {
            "type": "string",
            "description": "The name of the current room"
          },"region": {
            "type": "string",
            "description": "The region containing the current room"
          }
        }
      }
    ]
  },
  "ui": {
    "display": {
      "url": "https://gist.github.com/gulopine/4af953f43876c90a8dd70bad99b0c6e0/raw/c11fb634dd895a4616003acd8c76f35b67b3970b/display.html",
      "width": 300,
      "height": 30
    }
  },
